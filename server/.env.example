# Copy this file to server/.env for local development. Never commit server/.env.
# Required values are left empty on purpose: the server refuses to start until
# you fill them in, so placeholder values can never reach production.

NODE_ENV=development
PORT=4000

# MongoDB Atlas: Database > Connect > Drivers. Put a database name before the "?".
# Use firebreak_dev locally so testing never touches the live site's data.
# Shape: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/firebreak_dev?retryWrites=true&w=majority
MONGODB_URI=

# At least 32 random characters. Generate one with:
#   node -p "crypto.randomBytes(48).toString('base64url')"
JWT_SECRET=

# Comma-separated. Accounts registered with these emails become admins.
ADMIN_EMAILS=

# Optional. Defaults to https://api.osv.dev
OSV_BASE_URL=
